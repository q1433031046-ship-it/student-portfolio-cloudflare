{
  "schemaVersion": 1,
  "program": "student-portfolio-cloudflare",
  "version": "1.1.1",
  "releasedAt": "2026-08-29",
  "importance": "recommended",
  "releaseNotes": [
    "项目封面前台与后台改用同一套文字渲染规则，字号、宽度和换行按封面画布计算。",
    "封面排版新增桌面 16:9 与手机 4:5 预览切换。",
    "图片上传后未保存草稿时，管理员仍可预览，并提供本地回退、状态提示和重试。"
  ],
  "portfolioDocumentSchemaVersion": 4,
  "templateRepository": "https://github.com/q1433031046-ship-it/student-portfolio-cloudflare",
  "humanGuide": "README.md",
  "adminGuide": "password-protected administrator interface",
  "publicGuideRoute": null,
  "upgradePolicy": {
    "existingInstallCommand": "npm run cloudflare:deploy",
    "preserveExistingCloudflareResources": true,
    "neverReplaceResourceIdsDuringUpgrade": true,
    "preserve": [
      "existing Worker identity and workers.dev hostname",
      "D1 DB binding, resource id, migrations and all stored data",
      "MEDIA_KV binding, resource id and all uploaded media",
      "Cloudflare secrets and runtime variables",
      "administrator credentials, sessions and recovery state",
      "draft and published portfolio content",
      "access passes, analytics and audit records"
    ],
    "readBeforeUpgrade": [
      "README.md",
      "AGENTS.md",
      "deployment/agent-manifest.json",
      "deployment/template-version.json"
    ]
  }
}
